# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys/tokens.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Upstash Redis REST credentials (https://console.upstash.com)
# Create a Redis database there, then copy its REST URL + token below.
# Note: Upstash's free tier auto-deletes databases after a period of
# inactivity. If every request suddenly starts failing with "fetch failed",
# check whether the hostname below still resolves (`nslookup <host>`) before
# assuming it's a code bug — it's usually a deleted/expired database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enables the developer dashboard at /dev (sign in at /dev/login).
# Leave empty to disable it — every /dev route then returns 404.
# Must be at least 32 characters; generate one with: openssl rand -hex 32
DEV_DASHBOARD_TOKEN=

# --- Accounts (Better Auth) ---
# Postgres for users/accounts — a free Neon project works (https://console.neon.tech).
# Use the pooled connection string. After setting it, create the tables with:
#   npx auth@latest migrate
DATABASE_URL=

# Random secret for signing sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL (http://localhost:3000 locally, your deploy URL in production)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Contact (email or URL) sent in the User-Agent to Wikipedia/Wikimedia, per their
# User-Agent policy (https://meta.wikimedia.org/wiki/User-Agent_policy).
WIKI_CONTACT=
