# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys/tokens.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Upstash Redis REST credentials (https://console.upstash.com)
# Create a Redis database there, then copy its REST URL + token below.
# Note: Upstash's free tier auto-deletes databases after a period of
# inactivity. If every request suddenly starts failing with "fetch failed",
# check whether the hostname below still resolves (`nslookup <host>`) before
# assuming it's a code bug — it's usually a deleted/expired database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
